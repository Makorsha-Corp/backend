# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=MARKER API
VERSION=1.0.0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marker_db

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS (include landing page dev/preview origins; add Vercel URL on Railway prod)
# Production example:
# BACKEND_CORS_ORIGINS=https://frontend-theta-dusky-91.vercel.app,http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:4173"]

# Landing waitlist
# Optional legacy allowlist — platform admins (profiles.is_platform_admin) can access waitlist without this.
TURNSTILE_SECRET_KEY=
WAITLIST_ADMIN_EMAILS=you@example.com
WAITLIST_IP_HASH_SALT=

# Environment
ENVIRONMENT=development
DEBUG=true

# SSLCommerz payment gateway
SSLCOMMERZ_MOCK_MODE=true
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:8000

# Cloudinary (signed direct uploads — Railway only; never put API_SECRET on Vercel)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# development = Dev/ folder prefix; production on Railway hosted API
CLOUDINARY_UPLOAD_ENV=development

# Max non-deleted attachments per entity (PO, help ticket, etc.)
MAX_ATTACHMENTS_PER_ENTITY=25
